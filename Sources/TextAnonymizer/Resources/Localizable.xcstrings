    },
    "Copy the anonymized text from the right side and edit it externally or with an AI tool. Keep placeholders unchanged." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kopiere den anonymisierten Text von der rechten Seite und bearbeite ihn extern oder mit einem KI-Tool. Lasse Platzhalter unverändert." } }
